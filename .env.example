# Volt-Watt Electrical website — environment template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Public contact details shown on the site
VITE_CONTACT_PHONE="067 991 2218"
VITE_CONTACT_EMAIL="voltwattielectrical@gmail.com"

# Canonical site URL (used for sitemap/OG tags when deployed)
SITE_URL="https://example.com"

# Optional: endpoint for the quote form once a backend exists
# Leave empty to keep client-side-only confirmation behaviour.
QUOTE_FORM_ENDPOINT=""
